<?xml version="1.0" encoding="utf-8"?>

<!--
    Assignment 8 - Room Database

    This screen displays all podcasts that the user
    has saved as subscriptions in the Room database.

    The RecyclerView displays the saved podcasts.

    If there are no saved podcasts, a message tells
    the user that there are currently no subscriptions.
-->

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFF8FF">

    <!-- Screen title -->
    <TextView
        android:id="@+id/textSubscriptionsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My Subscriptions"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:gravity="center"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="16dp" />

    <!--
        This message is shown only when the Room
        database does not contain any subscriptions.
    -->
    <TextView
        android:id="@+id/textNoSubscriptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No subscriptions yet."
        android:textSize="17sp"
        android:textColor="#666666"
        android:gravity="center"
        android:padding="20dp"
        android:visibility="gone" />

    <!--
        RecyclerView displays all podcasts stored
        in the Room database.
    -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerSubscriptions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="8dp" />

    <!--
        Returns the user to the main podcast screen.
    -->
    <Button
        android:id="@+id/buttonSubscriptionsBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:backgroundTint="#7352B4"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp" />

</LinearLayout>